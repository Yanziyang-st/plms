# 统一按 LF 存入仓库，检出时由 Git 按平台转换，避免跨平台行尾抖动
* text=auto eol=lf

# Windows 批处理必须保持 CRLF，否则命令行解析会异常
*.cmd text eol=crlf
*.bat text eol=crlf

# 二进制文件不做行尾转换
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.woff binary
*.woff2 binary
*.ttf binary

# 第三方产物：不参与语言统计，避免污染仓库语言构成
plms-web/vendor/** linguist-vendored
plms-web/node_modules/** linguist-vendored
docs/preview/** linguist-documentation
legacy-static-demo/** linguist-vendored
